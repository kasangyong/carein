# ── 추론 위치 ──
# onprem  내부망 sLLM (기본값). 금융기관 배포를 전제로 한다
# gemini  Gemini API. 무료 한도가 있어 공개 데모에 적합하다
# claude  Claude API. 문서 판독 정확도가 가장 높다
#
# 어느 것을 쓰든 제도 판정과 금액 계산 결과는 동일하다.
# 판정이 모델이 아니라 지식베이스와 룰엔진에 있기 때문이다.
#
# 아무것도 설정하지 않아도 제도 판정·비용 계산·10년 시뮬레이션·퇴사 손익은
# 전부 동작한다. 모델이 필요한 것은 서류 자동 판독과 설명 문장 생성뿐이다.
AI_PROVIDER=onprem

# ── Gemini (공개 배포용) ──
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── 온프레미스 (내부망용) ──
# OpenAI 호환 엔드포인트. Ollama, vLLM 등
#
# 검증 완료 조합 — Ollama + LG exaone3.5 (한국어 모델)
#   ollama pull exaone3.5:7.8b
ONPREM_BASE_URL=http://localhost:11434
ONPREM_MODEL=exaone3.5:7.8b

# ── Claude ──
ANTHROPIC_API_KEY=
