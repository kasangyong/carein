# ── Claude API (문서 판독 + 설명 생성) ──
# 없어도 서비스의 핵심(제도 판정·비용 계산·시뮬레이션)은 전부 동작합니다.
# 없을 때 막히는 것은 "AI 설명 받기" 버튼 하나뿐입니다.
ANTHROPIC_API_KEY=

# ── 추론 위치 ──
# claude  = Claude API 사용 (기본)
# onprem  = 내부망 sLLM 사용. 금융기관 망분리 환경용
AI_PROVIDER=claude

# ── 온프레미스 모드일 때만 ──
# OpenAI 호환 엔드포인트 (Ollama, vLLM 등)
#
# 검증 완료 조합 — Ollama + LG exaone3.5(한국어 모델)
#   ONPREM_BASE_URL=http://localhost:11434
#   ONPREM_MODEL=exaone3.5:7.8b
#
# 이 모드에서 제도 판정과 금액 계산 결과는 Claude API 모드와 완전히 동일합니다.
# 판정이 모델이 아니라 지식베이스와 룰엔진에 있기 때문입니다.
ONPREM_BASE_URL=
ONPREM_MODEL=exaone3.5:7.8b
